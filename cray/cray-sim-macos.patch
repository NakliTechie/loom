diff --git a/simulator/sim_lib/utils.cpp b/simulator/sim_lib/utils.cpp
index 84e6ea1..38bdf41 100644
--- a/simulator/sim_lib/utils.cpp
+++ b/simulator/sim_lib/utils.cpp
