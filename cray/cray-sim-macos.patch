diff --git a/simulator/sim_lib/config_file.h b/simulator/sim_lib/config_file.h
index 4d75623..98a8803 100644
--- a/simulator/sim_lib/config_file.h
+++ b/simulator/sim_lib/config_file.h
@@ -105,6 +105,13 @@ FROM_STRING(uint32_t)
 FROM_STRING( int32_t)
 FROM_STRING(uint64_t)
 FROM_STRING( int64_t)
+// loom port: on Darwin (and wasm32) `unsigned long` / `long` are distinct from the fixed-width
+// types above, so size_t needs its own specialisation or it silently uses ptree's decimal-only
+// default translator (which cannot parse the 0x... addresses in the config files).
+#if defined(__APPLE__) || defined(__EMSCRIPTEN__)
+FROM_STRING(unsigned long)
+FROM_STRING(long)
+#endif
 
 #undef FROM_STRING
 
@@ -226,6 +233,14 @@ template<typename Ch, typename Traits, typename Alloc> struct translator_between
 template<typename Ch, typename Traits, typename Alloc> struct translator_between<std::basic_string< Ch, Traits, Alloc >, int64_t> {
     typedef IntTranslator_c<int64_t> type;
 };
+#if defined(__APPLE__) || defined(__EMSCRIPTEN__)
+template<typename Ch, typename Traits, typename Alloc> struct translator_between<std::basic_string< Ch, Traits, Alloc >, unsigned long> {
+    typedef IntTranslator_c<unsigned long> type;
+};
+template<typename Ch, typename Traits, typename Alloc> struct translator_between<std::basic_string< Ch, Traits, Alloc >, long> {
+    typedef IntTranslator_c<long> type;
+};
+#endif
 /****
 template<typename Ch, typename Traits, typename Alloc> struct translator_between<std::basic_string< Ch, Traits, Alloc >, CAddr_t> {
 	typedef CAddrTranslator_c type;
