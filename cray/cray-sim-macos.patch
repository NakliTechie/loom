 }
 
+#elif defined(__APPLE__) || defined(__EMSCRIPTEN__)
+
+// No CPU affinity API on these hosts (loom port): a no-op, the scheduler decides.
+void SetThreadAffinity(std::thread &aThread, size_t aCpuId) { (void)aThread; (void)aCpuId; }
